---
import Layout from "../layouts/Layout.astro";
import Footer from "../layouts/Footer.astro";
import Projects from "../layouts/FlagshipProjects.astro";
---

<!doctype html>
<Layout />
<html lang="en">
    <body>
        <main class="container">
            <!-- Projects Section -->
            <Projects />

            <!-- CTA Banner -->
            <section class="cta-banner">
                <h2>Building tools to better the future</h2>
                <p>
                    Open source software, libraries, and tools engineered with
                    minimal dependencies and maximum portability. Made to help
                    everyone equally.
                </p>
                <div class="cta-group">
                    <a
                        href="/about"
                        rel="noopener noreferrer"
                        class="btn btn-primary"
                    >
                        About us
                    </a>
                    <a
                        href="https://docs.ametrine.cc"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        Read Documentation
                    </a>
                </div>
            </section>
        </main>
    </body>
    <Footer />

    <script>
        let lastScrollY = window.scrollY;
        const nav = document.getElementById("navbar");

        window.addEventListener("scroll", () => {
            if (!nav) return;
            if (window.scrollY > 20) nav.classList.add("scrolled");
            else nav.classList.remove("scrolled");

            if (window.scrollY > lastScrollY && window.scrollY > 100)
                nav.classList.add("hidden");
            else nav.classList.remove("hidden");

            lastScrollY = window.scrollY;
        });
    </script>
</html>
