<script>
/* ── PRICING: currency + details toggle ── */
const BASE = { free: 0, prem: 9 };

function updatePricing(meta) {
  if (!meta) return;
  const { symbol, rate, currency } = meta;
  const freeP = rate === 1 ? "0" : +(BASE.free * rate).toFixed(rate < 2 ? 2 : 0);
  const premP = +(BASE.prem * rate).toFixed(rate < 2 ? 2 : 0);
  document.getElementById("free-sym").textContent = symbol;
  document.getElementById("free-price").textContent = freeP;
  document.getElementById("prem-sym").textContent = symbol;
  document.getElementById("prem-price").textContent = premP;
  const fNote = document.getElementById("free-currency-note");
  const pNote = document.getElementById("prem-currency-note");
  if (currency !== "USD") {
    fNote.textContent = `Approx. ${currency} (USD $${BASE.free})`;
    pNote.textContent = `Approx. ${currency} (USD $${BASE.prem})`;
  } else {
    fNote.textContent = "";
    pNote.textContent = "";
  }
}
document.addEventListener("i18n:change", (e) => updatePricing(e.detail.meta));

document.querySelectorAll("[data-details-toggle]").forEach((btn) => {
  btn.addEventListener("click", () => {
    const id = btn.dataset.detailsToggle;
    const det = document.getElementById(id + "-details");
    const open = det.classList.toggle("open");
    btn.classList.toggle("open", open);
    btn.setAttribute("aria-expanded", String(open));
    const dict = window.__i18nDict || {};
    btn.querySelector("span").textContent = open ? (dict.show_less || "Show less") : (dict.show_more || "Show more details");
  });
});

/* ── STARFIELD ── */
(function(){
const cv=document.getElementById('sf'),x=cv.getContext('2d');
let W,H,S=[];
function rsz(){W=cv.width=innerWidth;H=cv.height=innerHeight;}
function init(){S=[];const n=Math.floor(W*H/4400);for(let i=0;i<n;i++)S.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*.75+.1,o:Math.random()*.38+.06,s:Math.random()*.22+.04,t:Math.random()*Math.PI*2});}
rsz();init();window.addEventListener('resize',()=>{rsz();init();},{passive:true});
(function draw(){x.clearRect(0,0,W,H);S.forEach(s=>{s.t+=s.s*.016;const o=s.o*(.5+.5*Math.sin(s.t));x.beginPath();x.arc(s.x,s.y,s.r,0,Math.PI*2);x.fillStyle=s.r>.55?`rgba(196,160,250,${o})`:`rgba(208,208,235,${o*.6})`;x.fill();});requestAnimationFrame(draw);})();
})();

/* ── PROGRESS ── */
window.addEventListener('scroll',()=>{document.getElementById('sprog').style.transform=`scaleX(${scrollY/(document.documentElement.scrollHeight-innerHeight)})`;},{passive:true});

/* ── NAV ── */
const navEl=document.getElementById('nav');
window.addEventListener('scroll',()=>navEl.classList.toggle('on',scrollY>30),{passive:true});

/* ── MOBILE MENU ── */
(function(){
const burger=document.getElementById('navBurger'),menu=document.getElementById('mobileMenu');
if(!burger||!menu)return;
function closeMenu(){burger.setAttribute('aria-expanded','false');menu.classList.remove('open');document.body.classList.remove('menu-open');}
function openMenu(){burger.setAttribute('aria-expanded','true');menu.classList.add('open');document.body.classList.add('menu-open');}
burger.addEventListener('click',()=>{
const isOpen=burger.getAttribute('aria-expanded')==='true';
isOpen?closeMenu():openMenu();
});
menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
window.addEventListener('resize',()=>{if(innerWidth>700)closeMenu();},{passive:true});
})();

/* ── GEM PARALLAX ── */
(function(){
const g=document.getElementById('gem-wrap');if(!g||window.matchMedia('(pointer:coarse)').matches)return;
let tx=0,ty=0,cx=0,cy=0;
document.addEventListener('mousemove',e=>{tx=(e.clientX/innerWidth-.5)*18;ty=(e.clientY/innerHeight-.5)*11;},{passive:true});
(function t(){cx+=(tx-cx)*.05;cy+=(ty-cy)*.05;g.style.transform=`translate(${cx}px,${cy}px)`;requestAnimationFrame(t);})();
})();

/* ── REVEALS ── */
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}}),{threshold:.1,rootMargin:'0px 0px -20px 0px'});
document.querySelectorAll('.rv,.rv-l,.rv-r').forEach(el=>obs.observe(el));

/* ── COUNTERS ── */
document.querySelectorAll('[data-count]').forEach(el=>{
const o2=new IntersectionObserver(es=>{if(!es[0].isIntersecting)return;o2.unobserve(el);if(el._d)return;el._d=1;
const tgt=parseFloat(el.dataset.count),sfx=el.dataset.sfx||'',dur=1400,s=performance.now();
(function step(n){const p=Math.min((n-s)/dur,1),v=tgt*(1-Math.pow(1-p,3));el.textContent=(Number.isInteger(tgt)?Math.round(v):v.toFixed(1))+sfx;if(p<1)requestAnimationFrame(step);})(s);
},{threshold:.3});
o2.observe(el);
});

/* ── MAGNETIC BUTTONS ── */
document.querySelectorAll('.btn-fill,.btn-ghost,.nav-btn').forEach(b=>{
if(window.matchMedia('(pointer:coarse)').matches)return;
b.addEventListener('mousemove',e=>{const r=b.getBoundingClientRect(),x=(e.clientX-r.left-r.width/2)*.14,y=(e.clientY-r.top-r.height/2)*.14;b.style.transform=`translate(${x}px,${y}px)`;});
b.addEventListener('mouseleave',()=>b.style.transform='');
});

/* ── GLASS TILT ── */
document.querySelectorAll('.glass.vcard,.glass.pc').forEach(c=>{
if(window.matchMedia('(pointer:coarse)').matches)return;
c.addEventListener('mousemove',e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;c.style.transition='transform .08s';c.style.transform=`perspective(900px) rotateX(${(y-.5)*5}deg) rotateY(${(x-.5)*-5}deg) translateY(-2px)`;});
c.addEventListener('mouseleave',()=>{c.style.transition='transform .5s cubic-bezier(.22,1,.36,1)';c.style.transform='';});
});

/* ── SMOOTH ANCHORS ── */
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}}));
</script>
