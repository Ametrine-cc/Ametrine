---
import Head from "../components/Head.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ReleaseFeed from "../components/ReleaseFeed.astro";
import GemLogo from "../components/GemLogo.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ametrine Foundation — The company who cares.</title>
<meta name="description" content="Premium software built with privacy-first architecture. Professional-grade, priced for everyone.">
<link rel="stylesheet" href="/main.css">
<Head />
</head>
<body>

<div id="sprog" aria-hidden="true"></div>
<canvas id="sf" aria-hidden="true"></canvas>
<div id="glow" aria-hidden="true"></div>

<!-- NAV -->
<nav id="nav">
<a href="/" class="nav-logo" aria-label="Ametrine Foundation">
<GemLogo size={23} gradientId="ng" />
Ametrine
</a>
<div class="nav-links" role="navigation" aria-label="Primary">
<a href="#values" data-i18n="nav_values">Values</a>
<a href="#about" data-i18n="nav_about">About</a>
<a href="https://docs.ametrine.cc/" data-i18n="nav_docs">Docs</a>
<a href="#pricing" data-i18n="nav_pricing">Pricing</a>
</div>
<div class="nav-right">
<LanguageSwitcher />
<a href="#contact" class="nav-btn" data-i18n="nav_cta">Get started</a>
<button class="nav-burger" id="navBurger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
<span></span><span></span><span></span>
</button>
</div>
</nav>

<div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Mobile">
<a href="#values" data-i18n="nav_values">Values</a>
<a href="#about" data-i18n="nav_about">About</a>
<a href="https://docs.ametrine.cc/" data-i18n="nav_docs">Docs</a>
<a href="#pricing" data-i18n="nav_pricing">Pricing</a>
<a href="#contact" class="nav-btn" data-i18n="nav_cta">Get started</a>
</div>

<!-- HERO -->
<section aria-labelledby="hero-h">
<div class="hero">
<div class="hero-left">
<div class="hero-tag">
<span class="tag-dot" aria-hidden="true"></span>
<span data-i18n="hero_tag">Now in public access</span>
</div>
<h1 class="hero-h" id="hero-h">
<span data-i18n="hero_h1">Software that</span><br>
<span class="g" data-i18n="hero_h2">actually cares</span><br>
<span data-i18n="hero_h3">about you.</span>
</h1>
<p class="hero-p" data-i18n="hero_p">Privacy-first tools built for people, not for procurement — priced fairly and shipped without the tracking.</p>
<div class="hero-acts">
<a href="#about" class="btn-fill">
<span data-i18n="hero_cta1">Explore our work</span>
<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>
<a href="https://docs.ametrine.cc/" class="btn-ghost" data-i18n="hero_cta2">View documentation</a>
</div>
<div class="hero-kpis">
<div class="kpi">
<span class="kpi-v g">100%</span>
<span class="kpi-l" data-i18n="kpi1">Privacy-first</span>
</div>
<div class="kpi">
<span class="kpi-v">Fair</span>
<span class="kpi-l" data-i18n="kpi2">Pricing — always</span>
</div>
<div class="kpi">
<span class="kpi-v">Zero</span>
<span class="kpi-l" data-i18n="kpi3">Data sold</span>
</div>
</div>
</div>

<div class="hero-right" id="gem-wrap">
<svg class="gem-svg" viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<defs>
<linearGradient id="fv1" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#9B6EFA" stop-opacity=".55"/><stop offset="1" stop-color="#7040E0" stop-opacity=".1"/></linearGradient>
<linearGradient id="fv2" x1="1" y1="0" x2="0" y2="1"><stop stop-color="#C4A0FA" stop-opacity=".38"/><stop offset="1" stop-color="#9B6EFA" stop-opacity=".06"/></linearGradient>
<linearGradient id="fg1" x1="1" y1="0" x2="0" y2="1"><stop stop-color="#C89B3C" stop-opacity=".58"/><stop offset="1" stop-color="#E8BB60" stop-opacity=".1"/></linearGradient>
<linearGradient id="fg2" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#E8BB60" stop-opacity=".32"/><stop offset="1" stop-color="#C89B3C" stop-opacity=".04"/></linearGradient>
<linearGradient id="gs" x1="0" y1="0" x2="480" y2="480" gradientUnits="userSpaceOnUse"><stop stop-color="#C4A0FA"/><stop offset=".45" stop-color="#E8BB60"/><stop offset="1" stop-color="#9B6EFA"/></linearGradient>
<filter id="gf"><feGaussianBlur stdDeviation="3.5"/></filter>
</defs>
<circle cx="240" cy="240" r="218" fill="none" stroke="url(#gs)" stroke-width=".3" opacity=".09"/>
<circle cx="240" cy="240" r="170" fill="none" stroke="url(#gs)" stroke-width=".2" opacity=".06"/>
<polygon points="240,26 408,112 434,258 240,240" fill="url(#fv1)" opacity="0" style="animation:fi .7s ease 1.5s both"/>
<polygon points="240,240 46,258 120,410 240,454" fill="url(#fv2)" opacity="0" style="animation:fi .7s ease 1.65s both"/>
<polygon points="240,240 46,258 80,112" fill="url(#fv2)" opacity="0" style="animation:fi .7s ease 1.8s both"/>
<polygon points="240,26 408,112 434,258 240,240" fill="url(#fg1)" opacity="0" style="animation:fiG .7s ease 1.55s both"/>
<polygon points="240,240 434,258 360,410 240,454" fill="url(#fg2)" opacity="0" style="animation:fiG .7s ease 1.7s both"/>
<line x1="240" y1="26" x2="240" y2="454" stroke="url(#gs)" stroke-width=".6" opacity=".36" style="stroke-dasharray:900;stroke-dashoffset:900;animation:dl 1.8s ease .7s both"/>
<line x1="46" y1="258" x2="434" y2="258" stroke="url(#gs)" stroke-width=".6" opacity=".36" style="stroke-dasharray:900;stroke-dashoffset:900;animation:dl 1.8s ease .8s both"/>
<line x1="80" y1="112" x2="360" y2="410" stroke="url(#gs)" stroke-width=".5" opacity=".26" style="stroke-dasharray:900;stroke-dashoffset:900;animation:dl 1.8s ease .9s both"/>
<line x1="408" y1="112" x2="120" y2="410" stroke="url(#gs)" stroke-width=".5" opacity=".26" style="stroke-dasharray:900;stroke-dashoffset:900;animation:dl 1.8s ease 1.0s both"/>
<line x1="240" y1="240" x2="240" y2="26" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.1s both"/>
<line x1="240" y1="240" x2="408" y2="112" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.15s both"/>
<line x1="240" y1="240" x2="434" y2="258" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.2s both"/>
<line x1="240" y1="240" x2="360" y2="410" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.25s both"/>
<line x1="240" y1="240" x2="240" y2="454" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.3s both"/>
<line x1="240" y1="240" x2="120" y2="410" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.25s both"/>
<line x1="240" y1="240" x2="46" y2="258" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.2s both"/>
<line x1="240" y1="240" x2="80" y2="112" stroke="url(#gs)" stroke-width=".38" opacity=".18" style="stroke-dasharray:300;stroke-dashoffset:300;animation:dl 1.2s ease 1.15s both"/>
<polygon points="240,26 408,112 434,258 360,410 240,454 120,410 46,258 80,112" fill="none" stroke="url(#gs)" stroke-width="1.1" opacity=".7" style="stroke-dasharray:2200;stroke-dashoffset:2200;animation:dl 2s cubic-bezier(.22,1,.36,1) .3s both"/>
<circle cx="240" cy="26" r="3" fill="#C4A0FA" filter="url(#gf)" opacity="0" style="animation:dp .4s ease 2.2s both"/>
<circle cx="408" cy="112" r="2.6" fill="#E8BB60" filter="url(#gf)" opacity="0" style="animation:dp .4s ease 2.3s both"/>
<circle cx="434" cy="258" r="2.6" fill="#C4A0FA" opacity="0" style="animation:dp .4s ease 2.4s both"/>
<circle cx="360" cy="410" r="2.3" fill="#E8BB60" opacity="0" style="animation:dp .4s ease 2.5s both"/>
<circle cx="240" cy="454" r="3" fill="#C4A0FA" filter="url(#gf)" opacity="0" style="animation:dp .4s ease 2.6s both"/>
<circle cx="120" cy="410" r="2.3" fill="#E8BB60" opacity="0" style="animation:dp .4s ease 2.5s both"/>
<circle cx="46" cy="258" r="2.6" fill="#C4A0FA" opacity="0" style="animation:dp .4s ease 2.4s both"/>
<circle cx="80" cy="112" r="2.6" fill="#E8BB60" filter="url(#gf)" opacity="0" style="animation:dp .4s ease 2.3s both"/>
<circle cx="240" cy="240" r="4.2" fill="#C4A0FA" filter="url(#gf)" opacity="0" style="animation:dp .5s ease 2.7s both"/>
<style>
@keyframes dl{to{stroke-dashoffset:0;}}
@keyframes fi{from{opacity:0;}to{opacity:1;}}
@keyframes fiG{from{opacity:0;}to{opacity:.58;}}
@keyframes dp{from{opacity:0;}to{opacity:.92;}}
</style>
</svg>
</div>
</div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
<div class="ticker-track">
{Array.from({ length: 2 }).map(() => (
<>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#9B6EFA" stroke-width=".7"/><polygon points="4.5,.5 8.5,2.5 4.5,4.5" fill="#9B6EFA" opacity=".4"/></svg><span data-i18n="tick1">End-to-end encryption</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#C89B3C" stroke-width=".7"/><polygon points="4.5,.5 8.5,2.5 4.5,4.5" fill="#C89B3C" opacity=".4"/></svg><span data-i18n="tick2">No data brokering — ever</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#9B6EFA" stroke-width=".7"/></svg><span data-i18n="tick3">Professional-grade performance</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#C89B3C" stroke-width=".7"/></svg><span data-i18n="tick4">Accessible pricing — forever</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#9B6EFA" stroke-width=".7"/></svg><span data-i18n="tick5">Zero telemetry</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#C89B3C" stroke-width=".7"/></svg><span>99.9% uptime SLA</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#9B6EFA" stroke-width=".7"/></svg><span data-i18n="tick6">Privacy-first by design</span></div>
<div class="t-item"><svg class="t-gem" viewBox="0 0 9 9" fill="none"><polygon points="4.5,.5 8.5,2.5 8.5,6.5 4.5,8.5 .5,6.5 .5,2.5" stroke="#C89B3C" stroke-width=".7"/></svg>Ametrine Foundation</div>
</>
))}
</div>
</div>

<!-- VALUES -->
<section id="values" aria-labelledby="val-h">
<div class="sec">
<p class="eye rv" data-i18n="val_eye">What we stand for</p>
<h2 class="sh rv" id="val-h"><span data-i18n="val_h">Built different.</span><br><em data-i18n="val_h2">By design.</em></h2>
<p class="sp rv" data-i18n="val_p">Four principles that don't change no matter how big we get.</p>
<div class="val-grid">
<div class="glass vcard rv">
<span class="vcard-n">01</span>
<div class="vcard-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 1.5L17.5 5v4.5C17.5 14 14 17.7 10 18.5 6 17.7 2.5 14 2.5 9.5V5L10 1.5z" stroke="#9B6EFA" stroke-width="1.3" stroke-linejoin="round"/><path d="M6.5 10l2.5 2.5 5-5" stroke="#2DCB6A" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
<h3 class="vcard-t" data-i18n="v1_t">Privacy First</h3>
<p class="vcard-b" data-i18n="v1_p">Every product is built encryption-first, with zero telemetry and zero third-party trackers by default.</p>
</div>
<div class="glass vcard rv" style="transition-delay:.08s">
<span class="vcard-n">02</span>
<div class="vcard-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#9B6EFA" stroke-width="1.3"/><path d="M6.5 10l2.5 2.5 5-5" stroke="#9B6EFA" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
<h3 class="vcard-t" data-i18n="v2_t">Professional-Grade Performance</h3>
<p class="vcard-b" data-i18n="v2_p">Privacy tools shouldn't feel like a downgrade. Everything we ship is built to compete with the mainstream alternative.</p>
</div>
<div class="glass vcard rv" style="transition-delay:.16s">
<span class="vcard-n">03</span>
<div class="vcard-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2.5v1M10 16.5v1M2.5 10h1M16.5 10h1M4.9 4.9l.7.7M14.4 14.4l.7.7M4.9 15.1l.7-.7M14.4 5.6l.7-.7" stroke="#C89B3C" stroke-width="1.3" stroke-linecap="round"/><circle cx="10" cy="10" r="3" stroke="#C89B3C" stroke-width="1.3"/></svg></div>
<h3 class="vcard-t" data-i18n="v3_t">Cost-Effective — Forever</h3>
<p class="vcard-b" data-i18n="v3_p">Fair pricing isn't a launch promotion. Free stays genuinely useful as we grow.</p>
</div>
<div class="glass vcard rv" style="transition-delay:.24s">
<span class="vcard-n">04</span>
<div class="vcard-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3" stroke="#9B6EFA" stroke-width="1.3"/><path d="M3.5 17c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6" stroke="#9B6EFA" stroke-width="1.3" stroke-linecap="round"/></svg></div>
<h3 class="vcard-t" data-i18n="v4_t">User-Centric</h3>
<p class="vcard-b" data-i18n="v4_p">You're the customer, not the product. Every decision starts with what's good for the person using the software.</p>
</div>
</div>
</div>
</section>

<!-- STATS -->
<div class="stats-wrap">
<div class="stats-inner">
<div class="si rv"><span class="sn" data-count="100" data-sfx="%">0%</span><span class="sl" data-i18n="s1">Privacy compliance</span></div>
<div class="si rv" style="transition-delay:.07s"><span class="sn" data-count="0">0</span><span class="sl" data-i18n="s2">Data sold, ever</span></div>
<div class="si rv" style="transition-delay:.14s"><span class="sn" data-count="99.9" data-sfx="%">0%</span><span class="sl" data-i18n="s3">Uptime SLA</span></div>
<div class="si rv" style="transition-delay:.21s"><span class="sn">Fair</span><span class="sl" data-i18n="s4">Pricing — always</span></div>
</div>
</div>

<!-- ABOUT -->
<section id="about" aria-labelledby="about-h">
<div class="sec">
<div class="about-grid">
<div class="rv-l">
<div class="glass terminal">
<div class="thdr"><div class="td"></div><div class="td"></div><div class="td"></div><span>ametrine — audit</span></div>
<span class="tl"><span class="tp">$ </span><span class="tc">run privacy-check --deep</span></span>
<span class="tl"><span class="to">→ Scanning data collection...</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">No telemetry endpoints</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">No third-party trackers</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">No ad networks</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">No data brokering</span></span>
<span class="tl"><span class="to">→ Checking encryption...</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">E2E encryption: active</span></span>
<span class="tl"><span class="tok">✓ </span><span class="to">Zero-knowledge arch: verified</span></span>
<span class="tl">&nbsp;</span>
<span class="tl"><span class="tok">✓ ALL CLEAR — Score: 100/100</span></span>
<span class="tl"><span class="tp">$ </span><span class="tcur"></span></span>
</div>
</div>
<div class="rv-r">
<p class="eye" data-i18n="about_eye">Who we are</p>
<h2 class="sh" id="about-h"><span data-i18n="about_h">The company</span><br><em data-i18n="about_h2">who cares.</em></h2>
<p class="sp" data-i18n="about_p1">Ametrine Foundation builds software the way we'd want to use it ourselves — private by default, fast, and honestly priced.</p>
<p class="sp" style="margin-top:12px" data-i18n="about_p2">We're small on purpose. No investors to please, no growth targets that force compromises on the things that actually matter to the people using our tools.</p>
<div class="about-pill">
<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 .8l1.5 3 3.3.5-2.4 2.3.6 3.3L6 8.4l-3 1.5.6-3.3L1.2 4.3l3.3-.5L6 .8z" fill="#9B6EFA" opacity=".85"/></svg>
<span data-i18n="about_pill">Independently run, privacy-audited</span>
</div>
</div>
</div>
</div>
</section>

<!-- HOW -->
<section id="how" aria-labelledby="how-h">
<div class="sec" style="padding-top:0">
<div class="how-grid">
<div>
<p class="eye rv" data-i18n="how_eye">The process</p>
<h2 class="sh rv" id="how-h"><span data-i18n="how_h">How Ametrine</span><br><em data-i18n="how_h2">works for you</em></h2>
<p class="sp rv" data-i18n="how_p">Three principles guide every release, from the first line of code to the day it ships.</p>
</div>
<div class="tline rv-r">
<div class="tli lit">
<div class="tlc">1</div>
<div class="tl-b">
<p class="tl-e" data-i18n="tl1_e">Design</p>
<h3 class="tl-t" data-i18n="tl1_t">Privacy-native architecture</h3>
<p class="tl-p" data-i18n="tl1_p">Privacy isn't a setting you toggle on — it's the foundation every feature is designed around from day one.</p>
</div>
</div>
<div class="tli">
<div class="tlc">2</div>
<div class="tl-b">
<p class="tl-e" data-i18n="tl2_e">Build</p>
<h3 class="tl-t" data-i18n="tl2_t">Performance without compromise</h3>
<p class="tl-p" data-i18n="tl2_p">We optimise as hard for speed as we do for privacy, so protecting your data never means a slower product.</p>
</div>
</div>
<div class="tli">
<div class="tlc">3</div>
<div class="tl-b">
<p class="tl-e" data-i18n="tl3_e">Ship</p>
<h3 class="tl-t" data-i18n="tl3_t">Accessible to everyone</h3>
<p class="tl-p" data-i18n="tl3_p">Every release goes out with a free tier that's genuinely usable, not a crippled trial designed to push upgrades.</p>
</div>
</div>
</div>
</div>
</div>
</section>

<!-- RELEASES + KO-FI -->
<div class="releases-wrap" id="releases">
<div class="releases-inner">
<div class="rv-l">
<p class="eye" data-i18n="rel_eye">New releases</p>
<h2 class="sh" style="margin-bottom:6px" data-i18n="rel_h">Stay in the loop.</h2>
<p class="sp" data-i18n="rel_p">Short updates here — full write-ups and changelogs on Ko-fi.</p>
<div style="margin-top:28px">
<ReleaseFeed />
</div>
</div>

<div class="rv-r">
<div class="glass kofi-card">
<div class="kofi-header">
<div class="kofi-icon">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
<path d="M18 8h1a4 4 0 0 1 0 8h-1" stroke="#FF5E5B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" stroke="#FF5E5B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
<line x1="6" y1="1" x2="6" y2="4" stroke="#FF5E5B" stroke-width="1.5" stroke-linecap="round"/>
<line x1="10" y1="1" x2="10" y2="4" stroke="#FF5E5B" stroke-width="1.5" stroke-linecap="round"/>
<line x1="14" y1="1" x2="14" y2="4" stroke="#FF5E5B" stroke-width="1.5" stroke-linecap="round"/>
</svg>
</div>
<div>
<div class="kofi-title-text" data-i18n="kofi_t">Support on Ko-fi</div>
<div class="kofi-sub-text" data-i18n="kofi_s">Back the project, get early access</div>
</div>
</div>
<p class="sp" style="max-width:100%;font-size:13.5px" data-i18n="kofi_p">Ko-fi memberships fund development directly — no investors, no ads, no data deals.</p>
