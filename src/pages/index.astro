---
import Layout from "../layouts/Layout.astro";
import Footer from "../layouts/Footer.astro";

// Server-side script / Component data
const projects = [
    {
        name: "Kasane",
        tagline: "Module, package & project manager",
        description:
            "An open-source module manager, package manager, and build system written in Rust using AF_UNIX socket IPC architecture and privilege separation.",
        language: "Rust",
        license: "GPLv3",
        github: "https://github.com/ametrine-foundation/kasane",
    },
    {
        name: "miamore",
        tagline: "C Terminal User Interface library",
        description:
            "Lightweight C TUI library featuring 24-bit Truecolor rendering, display list command queues, multithreaded animation via pthreads, and official Rust bindings.",
        language: "C / Rust",
        license: "GPLv3",
        github: "https://github.com/ametrine-foundation/miamore",
    },
];

const year = new Date().getFullYear();
---

<!doctype html>
<Layout />
<html lang="en">
    <body>
        <!-- Main Content Container -->
        <main class="container">
            <!-- Projects Section -->
            <section id="projects" class="projects-section">
                <div class="section-header">
                    <h2>Projects</h2>
                    <p>
                        Privacy-first, local-first tools and system libraries
                        built without telemetry.
                    </p>
                </div>

                <div class="projects-grid">
                    {projects.map((project) => (
                        <div class="project-card">
                            <div class="card-header">
                                <span class="tech-badge">
                                    {project.language}
                                </span>
                                <span class="license-tag">
                                    {project.license}
                                </span>
                            </div>
                            <h3>{project.name}</h3>
                            <p class="tagline">{project.tagline}</p>
                            <p class="desc">{project.description}</p>
                            <div class="card-footer">
                                <a
                                    href={project.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="card-link"
                                >
                                    View Source →
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- CTA Banner -->
            <section class="cta-banner">
                <h2>Building for a local-first web.</h2>
                <p>
                    Open source software, libraries, and tools engineered with
                    minimal dependencies and maximum portability.
                </p>
                <div class="cta-group">
                    <a
                        href="https://github.com/ametrine-foundation"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary"
                    >
                        Explore Repositories
                    </a>
                    <a
                        href="https://docs.ametrine.cc"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        Read Documentation
                    </a>
                </div>
            </section>
        </main>
    </body>
    <Footer />

    <script>
        let lastScrollY = window.scrollY;
        const nav = document.getElementById("navbar");

        window.addEventListener("scroll", () => {
            if (!nav) return;
            if (window.scrollY > 20) nav.classList.add("scrolled");
            else nav.classList.remove("scrolled");

            if (window.scrollY > lastScrollY && window.scrollY > 100)
                nav.classList.add("hidden");
            else nav.classList.remove("hidden");

            lastScrollY = window.scrollY;
        });
    </script>
</html>
