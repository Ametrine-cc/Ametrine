---
interface Props {
    kofiUsername?: string;
}

const { kofiUsername = "ametrinefoundation" } = Astro.props;
const kofiUrl = `https://ko-fi.com/${kofiUsername}`;
---

<section class="kofi-section">
    <div class="kofi-card">
        <div class="kofi-header">
            <div class="icon-wrapper">
                <!-- Ko-fi Cup Icon -->
                <svg
                    viewBox="0 0 24 24"
                    width="28"
                    height="28"
                    fill="currentColor"
                >
                    <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 12.25 15.488 12.723 16.582 2.408 2.83-.255 7.039-1.956 7.277-10.435zM16.456 16.43c-.822 6.541-11.45 6.22-11.583-.162-.054-2.585-.015-8.857-.015-8.857h11.613s-.015 6.434-.015 9.019zm4.205-2.731c-.131 4.67-2.32 5.618-4.205 5.86V6.852h2.584s2.213.279 1.621 6.847z" />
                </svg>
            </div>
            <h2>Support Ametrine Foundation</h2>
            <p>
                If you find our projects useful, consider supporting our work!
                Every donation helps us keep developing open-source tools.
            </p>
        </div>

        <!-- Preset Coffee Tiers -->
        <div class="donation-tiers">
            <a
                href={kofiUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="tier-btn"
            >
                <span class="coffee-count">£2</span>
                <span class="tier-label">1 Donation</span>
            </a>
        </div>

        <!-- Primary CTA Button -->
        <div class="kofi-cta">
            <a
                href={kofiUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-kofi"
            >
                Support us on Ko-fi
                <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    .kofi-section {
        width: 100%;
        max-width: var(--mw, 1100px);
        margin: 0 auto 80px;
        padding: 0 var(--pad, 20px);
    }

    .kofi-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 40px 30px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        backdrop-filter: blur(20px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
        position: relative;
        overflow: hidden;
    }

    .kofi-card::before {
        content: "";
        position: absolute;
        top: -80px;
        left: 50%;
        transform: translateX(-50%);
        width: 250px;
        height: 150px;
        background: var(--primary);
        filter: blur(80px);
        opacity: 0.25;
        pointer-events: none;
    }

    .icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 94, 91, 0.12);
        color: #ff5e5b;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border: 1px solid rgba(255, 94, 91, 0.25);
    }

    .kofi-header h2 {
        font-size: clamp(22px, 4vw, 28px);
        font-weight: 700;
        color: var(--text);
        margin-bottom: 10px;
    }

    .kofi-header p {
        color: var(--text-secondary);
        font-size: 15px;
        line-height: 1.5;
        max-width: 540px;
        margin: 0 auto 28px;
    }

    .donation-tiers {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
        width: 100%;
        max-width: 600px;
        margin-bottom: 28px;
    }

    .tier-btn {
        flex: 1;
        min-width: 130px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        border-radius: 14px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        transition:
            transform 0.2s var(--ease),
            border-color 0.2s var(--ease),
            background 0.2s var(--ease);
    }

    .tier-btn:hover {
        transform: translateY(-3px);
        border-color: #ff5e5b;
        background: var(--bhi);
    }

    .tier-btn.featured {
        border-color: rgba(255, 94, 91, 0.4);
        background: rgba(255, 94, 91, 0.05);
    }

    .coffee-count {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    .tier-label {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .btn-kofi {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #ff5e5b;
        color: #ffffff;
        padding: 12px 28px;
        border-radius: 99px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(255, 94, 91, 0.35);
        transition:
            transform 0.2s var(--ease),
            background 0.2s var(--ease),
            box-shadow 0.2s var(--ease);
    }

    .btn-kofi:hover {
        background: #ff4a47;
        transform: scale(1.03);
        box-shadow: 0 6px 24px rgba(255, 94, 91, 0.5);
    }

    @media (max-width: 600px) {
        .donation-tiers {
            flex-direction: column;
        }

        .tier-btn {
            width: 100%;
            flex-direction: row;
            justify-content: space-between;
            padding: 12px 20px;
        }
    }
</style>
