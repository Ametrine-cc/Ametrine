---
const projects = [
    // {
    //     name: "Kasane",
    //     tagline: "Module, package & project manager",
    //     description:
    //         "An open-source module manager, package manager, and build system written in Rust using AF_UNIX socket IPC architecture and privilege separation.",
    //     language: "Rust",
    //     license: "GPLv3",
    //     github: "https://github.com/ametrine-foundation/kasane",
    // },
    {
        name: "miamore",
        tagline: "A better way of making TUI",
        description:
            "Lightweight C TUI library featuring 24-bit Truecolor rendering, display list command queues, multithreaded animation via pthreads, and official Rust bindings.",
        language: "C / Rust",
        license: "LGPLv3",
        github: "https://github.com/ametrine-cc/miamore",
    },
    {
        name: "uninstall-me",
        tagline: "Making uninstallation easy for everyone",
        description:
            "A small C Library with official Rust and Golang bindings, to allow programs to use '--uninstall' to uninstall all files for the program rather than rely on package managers to remove all files.",
        language: "C / Rust / Go",
        license: "GPLv3",
        github: "https://github.com/ametrine-cc/uninstall-me",
    },
];
---

<!doctype html>
<html lang="en">
    <section id="projects" class="projects-section">
        <h2>Flagship Projects</h2>
        <br />
        <div class="section-header">
            <h2>Libraries</h2>
            <p>
                Privacy-first, local-first tools and system libraries built
                without telemetry.
            </p>
        </div>

        <div class="projects-grid">
            {projects.map((project) => (
                <div class="project-card">
                    <div class="card-header">
                        <span class="tech-badge">{project.language}</span>
                        <span class="license-tag">{project.license}</span>
                    </div>
                    <h3>{project.name}</h3>
                    <p class="tagline">{project.tagline}</p>
                    <p class="desc">{project.description}</p>
                    <div class="card-footer">
                        <a
                            href={project.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="card-link"
                        >
                            View Source →
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </section>
</html>
