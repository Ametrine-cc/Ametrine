---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found" description="This page doesn't exist on ametrine.cc.">
    <section class="nf">
        <div class="wrap nf-inner">
            <div class="nf-mark" aria-hidden="true">
                <Mark size={120} />
            </div>
            <p class="nf-code">Error 404</p>
            <h1>This page doesn't exist</h1>
            <p class="nf-text">
                The link might be old, or the address might have a typo. Try searching, or head back to the
                home page.
            </p>
            <div class="btn-row nf-actions">
                <a class="btn btn-brand" href="/">Go to the home page</a>
                <button type="button" class="btn" data-open-search>
                    <Icon name="search" size={17} />
                    Search the site
                </button>
            </div>
        </div>
    </section>
</Base>

<style>
    .nf {
        padding-block: clamp(56px, 12vw, 140px);
    }

    .nf-inner {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .nf-mark {
        margin-bottom: 28px;
        filter: drop-shadow(0 20px 40px color-mix(in srgb, var(--violet) 45%, transparent));
    }

    @media (prefers-reduced-motion: no-preference) {
        .nf-mark {
            animation: wobble 2.4s var(--ease) both;
        }
    }

    @keyframes wobble {
        0% {
            transform: rotate(-180deg) scale(0.4);
            opacity: 0;
        }
        60% {
            transform: rotate(8deg) scale(1.02);
            opacity: 1;
        }
        100% {
            transform: rotate(0deg);
        }
    }

    .nf-code {
        color: var(--faint);
        font-weight: 600;
    }

    h1 {
        margin-top: 8px;
        font-size: var(--step-4);
        font-weight: 800;
        letter-spacing: -0.045em;
        max-width: 14ch;
    }

    .nf-text {
        margin-top: 18px;
        max-width: 46ch;
        color: var(--muted);
        font-size: var(--step-1);
        line-height: 1.5;
    }

    .nf-actions {
        justify-content: center;
        margin-top: 32px;
    }
</style>
